<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_14sdp" />
                    <gradient
                        android:angle="0"
                        android:startColor="#059669"
                        android:endColor="#047857"
                        android:type="linear" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_14sdp" />
                    <gradient
                        android:angle="0"
                        android:startColor="#10B981"
                        android:endColor="#059669"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#6EE7B7" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
