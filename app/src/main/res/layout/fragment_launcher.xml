<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Scrollable Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_dock_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_16sdp">

            <!-- NeoTerra Brand Logo Banner -->
            <ImageView
                android:id="@+id/neoterra_banner_logo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:src="@drawable/neoterra_logo"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="ADVANCED MINECRAFT JAVA LAUNCHER"
                android:textColor="#A855F7"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <!-- Quick Navigation Pills (Website & Telegram) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_10sdp"
                android:gravity="center">

                <Button
                    android:id="@+id/news_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:background="@drawable/background_glass_pill"
                    android:drawableStart="@drawable/ic_menu_news"
                    android:drawablePadding="@dimen/_6sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:text="@string/mcl_tab_wiki"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10ssp"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/discord_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="@drawable/background_glass_pill"
                    android:drawableStart="@drawable/ic_telegram"
                    android:drawablePadding="@dimen/_6sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:text="@string/mcl_button_discord"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10ssp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- NeoTerra Live Server Status Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/neoterra_server_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/background_glass_card_highlight"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/server_online_dot"
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:background="@drawable/background_glass_pill"
                    android:backgroundTint="#10B981"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/server_title_text"
                    app:layout_constraintBottom_toBottomOf="@+id/server_title_text" />

                <TextView
                    android:id="@+id/server_title_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:text="@string/neoterra_server_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/server_online_dot"
                    app:layout_constraintEnd_toStartOf="@+id/server_copy_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/server_ip_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="IP: play.neoterra.uz · 1.20.x - 1.21.x"
                    android:textColor="#38BDF8"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintStart_toEndOf="@id/server_online_dot"
                    app:layout_constraintEnd_toStartOf="@+id/server_copy_icon"
                    app:layout_constraintTop_toBottomOf="@id/server_title_text" />

                <ImageView
                    android:id="@+id/server_copy_icon"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:src="@drawable/ic_copy"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Quick Tools Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:text="@string/neoterra_quick_tools"
                android:textColor="#94A3B8"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Quick Tools Grid: Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/custom_control_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:background="@drawable/button_glass_action"
                    android:drawableStart="@drawable/ic_menu_custom_controls"
                    android:drawablePadding="@dimen/_6sdp"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="@string/mcl_option_customcontrol"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10ssp"
                    android:textAllCaps="false"
                    android:gravity="center_vertical|start" />

                <Button
                    android:id="@+id/install_jar_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="@drawable/button_glass_action"
                    android:drawableStart="@drawable/ic_menu_install_jar"
                    android:drawablePadding="@dimen/_6sdp"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="@string/main_install_jar_file"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10ssp"
                    android:textAllCaps="false"
                    android:gravity="center_vertical|start" />
            </LinearLayout>

            <!-- Quick Tools Grid: Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_8sdp">

                <Button
                    android:id="@+id/open_files_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:background="@drawable/button_glass_action"
                    android:drawableStart="@drawable/ic_folder"
                    android:drawablePadding="@dimen/_6sdp"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="@string/mcl_button_open_directory"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10ssp"
                    android:textAllCaps="false"
                    android:gravity="center_vertical|start" />

                <Button
                    android:id="@+id/share_logs_button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="@drawable/button_glass_action"
                    android:drawableStart="@android:drawable/ic_menu_share"
                    android:drawablePadding="@dimen/_6sdp"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:text="@string/main_share_logs"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10ssp"
                    android:textAllCaps="false"
                    android:gravity="center_vertical|start" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Floating Dock Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_dock_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_version_dock"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Version Selector Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/version_dock_card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/background_glass_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:drawableEnd="@drawable/spinner_arrow"
                app:drawableEndSize="@dimen/padding_heavy"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="@dimen/_32sdp"
                app:drawableEndPadding="@dimen/_4sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="?android:attr/selectableItemBackground"
                android:src="@drawable/ic_edit_profile"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- The Epic O'YNASH (PLAY) Launch Button -->
        <Button
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/button_play_emerald"
            android:text="@string/main_play"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:drawableStart="@drawable/ic_play_triangle"
            android:drawablePadding="@dimen/_8sdp"
            android:gravity="center"
            android:elevation="@dimen/_4sdp"
            app:layout_constraintTop_toBottomOf="@id/version_dock_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
